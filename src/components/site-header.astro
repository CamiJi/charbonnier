---
import { getContent, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  alternatePath?: string;
  currentPath?: string;
}

const { locale, alternatePath, currentPath } = Astro.props;
const t = getContent(locale);
const homeHref = (anchor: string): string => `${site.path(locale)}#${anchor}`;
const activeLanguageHref = currentPath ?? homeHref('about');
---

<header class="site-header">
  <div class="header-topline">
    <a class="wordmark" href={homeHref('about')} aria-label={t.about.name}>
      <span class="wordmark-symbol" aria-hidden="true">QC</span>
      <span>{t.about.name}</span>
    </a>
    <p class="header-coordinate" aria-label={locale === 'fr' ? 'Localisation' : 'Location'}>
      <span aria-hidden="true">N</span> 46°47′ &nbsp; <span aria-hidden="true">E</span> 04°45′
      <span class="coordinate-place">· {locale === 'fr' ? 'Givry, France' : 'Givry, France'}</span>
    </p>
    <nav class="language-switch" aria-label={locale === 'fr' ? 'Langue' : 'Language'}>
      <a href={locale === 'fr' ? activeLanguageHref : (alternatePath ?? site.path('fr'))} lang="fr" aria-current={locale === 'fr' ? 'page' : undefined}>FR</a>
      <span aria-hidden="true">/</span>
      <a href={locale === 'en' ? activeLanguageHref : (alternatePath ?? site.path('en'))} lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
    </nav>
  </div>
  <div class="header-bottomline">
    <p>{t.ui.siteLabel}</p>
    <nav class="section-nav" aria-label={t.ui.menuLabel}>
      <a href={homeHref('experience')}>{t.ui.sections.experience}</a>
      <a href={homeHref('work')}>{t.ui.sections.work}</a>
      <a href={homeHref('education')}>{t.ui.sections.education}</a>
      <a href={homeHref('skills')}>{t.ui.sections.skills}</a>
      <a href={homeHref('contact')}>{t.ui.sections.contact}</a>
    </nav>
  </div>
</header>
