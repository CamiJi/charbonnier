---
import MacWindow from '../mac-window.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<MacWindow id="contact" title={t.contact.windowTitle} index={7}>
  <p class="text-[14.5px] leading-relaxed">{t.contact.text}</p>
  <dl class="mt-4 m-0">
    {t.contact.items.map((item) => (
      <div class="info-row">
        <dt>{item.label}</dt>
        <dd class="m-0">
          {item.href ? (
            <a class="underline decoration-dotted underline-offset-4 hover:bg-ink hover:text-window hover:decoration-none" href={item.href}>
              {item.value}
            </a>
          ) : (
            item.value
          )}
        </dd>
      </div>
    ))}
  </dl>
  <a class="mac-button mac-button--primary mt-5" href={`mailto:${t.ui.email}`}>{t.contact.cta}</a>
</MacWindow>
