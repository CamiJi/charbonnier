---
interface Props {
  id: string;
  title: string;
  kicker: string;
  class?: string;
}

const { id, title, kicker, class: className } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} class:list={['section-panel', className]} aria-labelledby={headingId}>
  <header class="section-heading">
    <p class="section-kicker">{kicker}</p>
    <h2 id={headingId}>{title}</h2>
  </header>
  <div class="section-content">
    <slot />
  </div>
</section>
