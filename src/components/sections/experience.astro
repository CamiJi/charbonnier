---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="experience" title={t.experience.windowTitle} kicker={locale === 'fr' ? 'LOGUE STRATIGRAPHIQUE / 2010—2026' : 'STRATIGRAPHIC LOG / 2010—2026'} class="experience-panel">
  <p class="section-lede">{t.experience.subtitle}</p>
  <div class="strata-legend" role="group" aria-label={t.experience.legendTitle}>
    <p class="legend-title">{t.experience.legendTitle}</p>
    <ul>
      {t.experience.legend.map((item) => (
        <li data-stratum={item.stratum}>
          <span class="legend-pattern" aria-hidden="true"></span>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
  <ol class="stratigraphy">
    {t.experience.items.map((item, index) => (
      <li class="strata-unit" data-stratum={item.stratum}>
        <span class="unit-pattern" aria-hidden="true"></span>
        <article class="unit-copy">
          <header class="unit-meta">
            <p class="entry-period">{item.period}</p>
            <span class="unit-kind">{item.kind}</span>
          </header>
          <h3 class="entry-org">{item.org}</h3>
          <p class="entry-role">{item.role}</p>
          {item.bullets.length > 0 && (
            <ul class="experience-details">
              {item.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </article>
        <span class="unit-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      </li>
    ))}
  </ol>
</SectionPanel>
