---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site-header.astro';
import SiteFooter from '../components/site-footer.astro';
import Desktop from '../components/desktop.astro';

const locale = 'fr' as const;
---

<Layout locale={locale}>
  <SiteHeader slot="header" locale={locale} />
  <Desktop locale={locale} />
  <SiteFooter slot="footer" locale={locale} />
</Layout>
