---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="skills" title={t.skills.windowTitle} kicker={locale === 'fr' ? 'OUTILS & SAVOIR-FAIRE' : 'TOOLS & METHODS'}>
  <div class="skills-grid">
    {t.skills.groups.map((group) => (
      <section class="skill-group">
        <h3 class="group-title">{group.name}</h3>
        <ul class="skill-list">
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    ))}
  </div>
</SectionPanel>
