---
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<section id="about" class="hero-section grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 max-[600px]:block" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="hero-kicker"><span class="hero-marker" aria-hidden="true"></span>{t.about.role}</p>
    <h1 id="hero-heading" class="hero-name">{t.about.name}</h1>
    <p class="hero-tagline">{t.about.tagline}</p>
    <div class="hero-actions">
      <a class="text-link" href={`mailto:${t.ui.email}`}>{t.about.write}</a>
      <a class="quiet-link" href={`tel:${t.ui.phone.replace(/\s/g, '')}`}>{t.about.call}</a>
    </div>
  </div>
  <p class="hero-index" aria-hidden="true">01<br /><span>QC</span></p>
</section>
