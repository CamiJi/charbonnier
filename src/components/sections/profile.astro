---
import MacWindow from '../mac-window.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<MacWindow id="profile" title={t.profile.windowTitle} index={5}>
  <h3 class="group-title">{t.profile.qualitiesTitle}</h3>
  <ul class="bullets">
    {t.profile.qualities.map((quality) => <li>{quality}</li>)}
  </ul>

  <h3 class="group-title mt-5">{t.profile.interestsTitle}</h3>
  <div class="tags">
    {t.profile.interests.map((interest) => <span class="tag">{interest}</span>)}
  </div>
</MacWindow>
