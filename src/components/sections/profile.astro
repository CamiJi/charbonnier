---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="profile" title={t.profile.windowTitle} kicker={locale === 'fr' ? 'HORS TERRAIN' : 'BEYOND THE FIELD'}>
  <h3 class="group-title">{t.profile.qualitiesTitle}</h3>
  <ul class="quality-list">
    {t.profile.qualities.map((quality) => <li>{quality}</li>)}
  </ul>

  <h3 class="group-title mt-5">{t.profile.interestsTitle}</h3>
  <ul class="interest-list">
    {t.profile.interests.map((interest) => <li>{interest}</li>)}
  </ul>
</SectionPanel>
