---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="contact" title={t.contact.windowTitle} kicker={locale === 'fr' ? 'ÉCHANGE / CONTACT' : 'GET IN TOUCH'} class="contact-panel grid grid-cols-1 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
  <p class="contact-intro">{t.contact.text}</p>
  <dl class="contact-list">
    {t.contact.items.map((item) => (
      <div class="contact-row">
        <dt>{item.label}</dt>
        <dd>
          {item.href ? (
            <a href={item.href}>
              {item.value}
            </a>
          ) : (
            item.value
          )}
        </dd>
      </div>
    ))}
  </dl>
  <a class="text-link" href={`mailto:${t.ui.email}`}>{t.contact.cta}</a>
</SectionPanel>
