---
import '../styles/global.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import { site } from '../data/site';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonical?: string;
  alternateHref?: string;
  pageType?: 'profile' | 'article' | 'website';
}

const { locale } = Astro.props;
const t = getContent(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const canonical = Astro.props.canonical ?? site.href(locale);
const alternateLocale: Locale = locale === 'fr' ? 'en' : 'fr';
const alternateHref = Astro.props.alternateHref ?? site.href(alternateLocale);
const pageType = Astro.props.pageType ?? 'profile';
const xDefaultHref = pageType === 'article'
  ? (locale === 'fr' ? canonical : alternateHref)
  : site.href('fr');

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: 'Quentin Charbonnier',
  jobTitle: 'Exploration and Resources Geologist',
  description: t.meta.description,
  url: site.href(locale),
  email: 'mailto:quentin.charbonnier71@gmail.com',
  telephone: '+33661161331',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Givry',
    postalCode: '71640',
    addressCountry: 'FR',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Université Paul Sabatier — Toulouse 3' },
    { '@type': 'CollegeOrUniversity', name: 'Université de Bordeaux' },
  ],
  knowsLanguage: ['fr', 'en', 'de'],
  sameAs: [site.profiles.linkedIn],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={site.asset('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F2EDE4" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:site_name" content={site.name} />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <slot name="head" />
  </head>

  <body class="antialiased">
    <div class="topographic-overlay" aria-hidden="true">
      <img src={site.asset('/contours.svg')} alt="" width="1200" height="900" />
    </div>
    <a
      href="#main-content"
      class="skip-link"
    >
      {t.ui.skipToContent}
    </a>

    <slot name="header" />

    <main id="main-content" class="page-shell">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
