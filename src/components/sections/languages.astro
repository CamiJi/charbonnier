---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="languages" title={t.languages.windowTitle} kicker={locale === 'fr' ? 'LANGUES / FR—EN—DE' : 'LANGUAGES / FR—EN—DE'}>
  <ul class="language-list">
    {t.languages.items.map((item) => (
      <li class="language-entry">
        <h3>{item.name}</h3>
        <p>{item.level}</p>
      </li>
    ))}
  </ul>
</SectionPanel>
