---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="education" title={t.education.windowTitle} kicker={locale === 'fr' ? 'ENSEIGNEMENT / 2017—2025' : 'EDUCATION / 2017—2025'}>
  <ol class="education-list">
    {t.education.items.map((item) => (
      <li class="education-entry">
        <div class="education-meta">
          <span class="entry-period">{item.period}</span>
        </div>
        <h3 class="entry-org">{item.school}</h3>
        <p class="entry-role">{item.degree}</p>
        {item.bullets.length > 0 && (
          <ul class="education-details">
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        )}
      </li>
    ))}
  </ol>
</SectionPanel>
