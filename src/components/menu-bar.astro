---
import { getContent, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const alternate: Locale = locale === 'fr' ? 'en' : 'fr';

const links = [
  { id: 'about', label: t.ui.sections.about },
  { id: 'experience', label: t.ui.sections.experience },
  { id: 'education', label: t.ui.sections.education },
  { id: 'skills', label: t.ui.sections.skills },
  { id: 'languages', label: t.ui.sections.languages },
  { id: 'profile', label: t.ui.sections.profile },
  { id: 'contact', label: t.ui.sections.contact },
] as const;
---

<header class="menu-bar">
  <details class="apple-menu" aria-label={t.ui.appleMenuLabel}>
    <summary>
      <svg viewBox="0 0 12 14" width="11" height="13" shape-rendering="crispEdges" aria-hidden="true">
        <rect x="0.5" y="0.5" width="11" height="13" fill="#ffffff" stroke="#000000"></rect>
        <rect x="1.5" y="1.5" width="9" height="7" fill="#eeeeee" stroke="#000000"></rect>
        <rect x="3" y="3" width="1" height="1" fill="#000000"></rect>
        <rect x="8" y="3" width="1" height="1" fill="#000000"></rect>
        <rect x="4" y="6" width="4" height="1" fill="#000000"></rect>
        <rect x="3" y="5" width="1" height="1" fill="#000000"></rect>
        <rect x="8" y="5" width="1" height="1" fill="#000000"></rect>
        <rect x="7" y="10" width="3" height="1" fill="#000000"></rect>
      </svg>
      <span class="sr-only">{t.ui.appleMenuTitle}</span>
    </summary>
    <div class="apple-menu-panel">
      <a href="#about">{t.ui.sections.about} — Quentin Charbonnier</a>
      <a href="#contact">{t.ui.sections.contact}</a>
      <div class="apple-menu-sep" role="presentation"></div>
      <a href={site.path(alternate)} hreflang={alternate}>{t.ui.switchLang}</a>
      <div class="apple-menu-sep" role="presentation"></div>
      <a href={`mailto:${t.ui.email}`}>{t.ui.email}</a>
      <a href={`tel:${t.ui.phone.replace(/\s/g, '')}`}>{t.ui.phone}</a>
    </div>
  </details>

  <nav class="menu-scroll" aria-label={t.ui.menuLabel}>
    {links.map((link) => (
      <a class="menu-link" href={`#${link.id}`} data-section={link.id}>
        {link.label}
      </a>
    ))}
  </nav>

  <div class="menu-right">
    <span class="lang-switch" aria-label="Language">
      <a href={site.path('fr')} lang="fr" aria-current={locale === 'fr' ? 'true' : undefined}>FR</a>
      <a href={site.path('en')} lang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
    </span>
    <time class="menu-cell" id="menu-clock" aria-label={t.ui.clockLabel}>--:--</time>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>
