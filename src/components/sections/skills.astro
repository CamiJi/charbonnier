---
import MacWindow from '../mac-window.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<MacWindow id="skills" title={t.skills.windowTitle} index={6} span="span-2">
  <div class="grid gap-5 sm:grid-cols-2">
    {t.skills.groups.map((group) => (
      <div>
        <h3 class="group-title">{group.name}</h3>
        <div class="tags">
          {group.items.map((item) => <span class="tag">{item}</span>)}
        </div>
      </div>
    ))}
  </div>
</MacWindow>
