---
import SectionPanel from '../section-panel.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<SectionPanel id="system" title={t.system.windowTitle} kicker={locale === 'fr' ? 'REPÈRES / GIVRY' : 'FIELD NOTES / GIVRY'} class="system-panel">
  <dl class="facts-list">
    {t.system.rows.map((row) => (
      <div class="fact-row">
        <dt>{row.label}</dt>
        <dd>{row.value}</dd>
      </div>
    ))}
  </dl>
</SectionPanel>
